{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/login",
      "dest": "/auth.html#signin"
    },
    {
      "src": "/signup",
      "dest": "/auth.html#signup"
    },
    {
      "src": "/auth",
      "dest": "/auth.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
